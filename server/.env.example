# Copy to .env and fill in. `.env` is gitignored; this file is not.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Default below targets the Postgres already running on your machine via
# Homebrew. Replace USER with your postgres role — on a Homebrew install that
# is your macOS username, with no password and trust auth:
#
#   psql -d postgres -c 'select current_user'
#   createdb meal_planner
#
DATABASE_URL="postgresql://USER@localhost:5432/meal_planner?schema=public"

# Separate throwaway database for the test suite. `npm test` migrates it and
# truncates it between tests, so it must NOT be the database above. The name
# has to end in "_test" — vitest.config.ts refuses to run otherwise, which is
# what stops a copy-paste slip from wiping your dev data.
#
#   createdb meal_planner_test
#
TEST_DATABASE_URL="postgresql://USER@localhost:5432/meal_planner_test?schema=public"

# Using docker-compose.yml instead? Comment the line above and use this one.
# The port is 5433 because Homebrew Postgres already owns 5432.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/meal_planner?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs the 15-minute access tokens (MP-12). Must be >= 32 chars.
# Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Port the API listens on.
PORT=4000

# The browser origin allowed to send credentialed requests. Vite's default.
CLIENT_ORIGIN="http://localhost:5173"
