# Copy to .env and fill in. `.env` is gitignored; this file is not.

# Postgres connection string. The database itself arrives in MP-11 —
# nothing connects to it yet, so any valid-looking URL boots the server.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meal_planner?schema=public"

# Signs the 15-minute access tokens (MP-12). Must be >= 32 chars.
# Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Port the API listens on.
PORT=4000

# The browser origin allowed to send credentialed requests. Vite's default.
CLIENT_ORIGIN="http://localhost:5173"
